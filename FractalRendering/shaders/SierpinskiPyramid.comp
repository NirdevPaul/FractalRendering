	vec3 val = pyrify(currIndex, ubo.subdivisionCount);

	float r = pow(2.0f, -ubo.subdivisionCount);
	/*
	vertices[4*currIndex + 0].pos.xyz = val + r*deltas[0];
	vertices[4*currIndex + 1].pos.xyz = val + r*deltas[1];
	vertices[4*currIndex + 2].pos.xyz = val + r*deltas[2];
	vertices[4*currIndex + 3].pos.xyz = val + r*deltas[3];
	*/
	for (int i = 0; i < 4; ++ i) {
		//vec3 curr_pos = val + r*deltas[i];
		//curr_pos = deltas[i];
		/*
		curr_pos.x = mix(-1., 1., (curr_pos.x - ubo.lo_xy.x)/(ubo.hi_xy.x-ubo.lo_xy.x));
		curr_pos.y = mix(1., -1.,  (curr_pos.y - ubo.lo_xy.y)/(ubo.hi_xy.y-ubo.lo_xy.y));
		*/
		//curr_pos.x /= ((ubo.hi_xy.x - ubo.lo_xy.x)/2.f);
		vertices[4*currIndex + i].pos.xyz = curr_pos;
		vertices[4*currIndex + i].pos.w = 1.0f;
	}

	vec4 white = vec4(1, 1, 1, 1);
	vertices[4*currIndex + 0].color = white;
