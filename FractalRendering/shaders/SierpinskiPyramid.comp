#version 460

layout(set = 0, binding = 0) uniform ParameterUBO {
	vec2 lo_xy;
	vec2 hi_xy;
	vec2 julia_c;

	int subdivisionCount;
} ubo;
struct Vertex {
	vec4 pos;
	vec4 color;
};
layout(std430, set = 1, binding = 0) buffer VertexBuffer {
	Vertex vertices[];
};

layout(std430, set = 1, binding = 1) buffer IndexBuffer {
	uint indices[];
};


float tetrahedron_height = sqrt(2.)/sqrt(3.);
float tri_center_dist = inversesqrt(3.);
vec3 deltas[4] = {
	{0, 0, 3./4. * tetrahedron_height},
	{0, tri_center_dist, -1./4. * tetrahedron_height},
	{-1./2., -1./2. * tri_center_dist, -1./4. * tetrahedron_height},
	{1./2., -1./2. * tri_center_dist, -1./4. * tetrahedron_height},
};


vec3 pyrify(int a, int n) {
	vec3 acc = vec3(0, 0, 0);
	for (int i = 0; i < n; ++i) {
		acc += deltas[a%4];
		acc /= 2.0f;
		a /= 4;
	}
	return acc;
}

layout (local_size_x = 64, local_size_y = 1) in;
void main() {
	/*
